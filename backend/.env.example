DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optional second DB for Admin → Tills (transactions.credit by phone + value_date)
TRANSACTION_DATABASE_URL=postgresql://user:password@host/transactions-db?sslmode=require
PHONE_NUMBER=0766*******5
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_EXPIRE_HOURS=24
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=900
# Render cron keep-warm (production): full ready URL or API base.
# Pings /api/health/ready every 5m — wakes hotel DB and transactions DB when configured.
# HEALTH_PING_URL=https://hotel-api.onrender.com/api/health/ready
